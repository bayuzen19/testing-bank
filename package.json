{
  "name": "testing-bank",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "node --env-file=.env server/index.mjs",
    "build": "vite build",
    "start": "node server/index.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:coverage": "c8 --reporter=text --reporter=lcov --reporter=json-summary --include=server/**/*.mjs --exclude=server/index.mjs --all node --test --test-concurrency=1 tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "express": "5.2.1",
    "pg": "8.23.0",
    "helmet": "8.3.0",
    "express-rate-limit": "8.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "vite": "8.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@playwright/test": "1.63.0",
    "c8": "12.0.0"
  }
}
